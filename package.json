{
  "name": "annotation-compositor",
  "version": "1.0.5",
  "description": "Zotero plugin adding a folder/subfolder organisation layer over the annotations of a single item, with multi-membership, colour rules, sticky groups and templated export.",
  "config": {
    "addonName": "Annotation Compositor",
    "addonID": "annotation-compositor@jsglazer.com",
    "addonRef": "annotationcompositor",
    "addonInstance": "AnnotationCompositor",
    "prefsPrefix": "extensions.zotero.annotationcompositor"
  },
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "tsc --noEmit && zotero-plugin build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "prettier --write . && eslint .",
    "release": "zotero-plugin release"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jsglazer/annotation-compositor.git"
  },
  "author": "Josh Glazer",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jsglazer/annotation-compositor/issues"
  },
  "homepage": "https://github.com/jsglazer/annotation-compositor",
  "dependencies": {
    "zotero-plugin-toolkit": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^2.1.8",
    "zotero-plugin-scaffold": "^0.8.0",
    "zotero-types": "^4.1.0-beta.8"
  }
}
