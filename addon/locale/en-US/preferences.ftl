# Message ids are prefixed with the plugin namespace at build time, so
# "pref-title" is addressed as "annotationcompositor-pref-title".
pref-title = Annotation Compositor
pref-tag-prefix-label = Tag prefix
pref-tag-type-label = Group tag type
pref-tag-type-manual =
    .label = Manual
pref-tag-type-automatic =
    .label = Automatic
pref-tag-type-description = Manual tags (the default) are ignored by Zotero's "Delete Automatic Tags in This Library" command. Automatic tags are not — switching rewrites every existing group tag.
pref-navigate-on-click =
    .label = Navigate to the annotation when clicking it in the panel
pref-persist-sticky-group =
    .label = Remember each tab's pinned folder across restarts
pref-include-subfolders =
    .label = Include subfolders when exporting a folder
pref-include-ungrouped =
    .label = Include ungrouped annotations when exporting
pref-sticky-on-create =
    .label = Pre-tick "pin as sticky folder" in the new-folder dialog
pref-sync-settings =
    .label = Sync these settings across my devices
pref-sync-settings-description = Settings travel with your Zotero account through Zotero sync. Each reader tab's pinned folder and the first-run notice stay local to this machine.
pref-use-custom-selection-color =
    .label = Use a custom highlight color for selected rows
pref-selection-color-label = Selection highlight color
pref-template-label = Default export template
