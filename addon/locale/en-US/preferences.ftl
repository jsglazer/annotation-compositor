# Message ids are prefixed with the plugin namespace at build time, so
# "pref-title" is addressed as "annotationcompositor-pref-title".
pref-title = Annotation Compositor
pref-tag-prefix-label = Tag prefix
pref-tag-type-label = Group tag type
pref-tag-type-manual =
    .label = Manual
pref-tag-type-automatic =
    .label = Automatic
pref-tag-type-description = Automatic tags (the default) are what Zotero's "Delete Automatic Tags in This Library" command removes in bulk; manual tags are ignored by it. Switching only affects newly-written tags; existing group tags keep the type they were written with.
pref-navigate-on-click =
    .label = Navigate to the annotation when clicking it in the panel
pref-arrow-keys-scroll =
    .label = Up/Down arrow keys scroll the panel instead of moving to the next/previous annotation
pref-persist-sticky-group =
    .label = Remember each item's pinned folder across restarts
pref-include-subfolders =
    .label = Include subfolders when exporting a folder
pref-include-ungrouped =
    .label = Include ungrouped annotations when exporting
pref-sticky-on-create =
    .label = Pre-tick "pin as sticky folder" in the new-folder dialog
pref-pin-groups-panel =
    .label = Pin the Groups panel as the default item-pane view on startup
pref-pin-groups-panel-description = Uses Zotero's own "pin a section" feature, so it applies to every item in your library, not just ones with annotations. Re-applied every time Zotero starts, overriding any pin you set yourself in the meantime.
pref-sync-settings =
    .label = Sync these settings across my devices
pref-sync-settings-description = Settings travel with your Zotero account in a note titled “Annotation Compositor settings” (tagged _annotation-compositor-settings) in My Library, which Zotero syncs like any other item. Leave that note in place. Each item's pinned folder and the first-run notice stay local to this machine.
pref-restore-grouping =
    .label = Restore previous grouping…
pref-restore-grouping-description = Rolls the item open in the reader (or the item selected in your library) back to an earlier snapshot of its folders. A snapshot is written before every change, and you see a preview before anything is restored.
pref-use-custom-selection-color =
    .label = Use a custom highlight color for selected rows
pref-selection-color-label = Selection highlight color
pref-template-label = Default export template
pref-template-markdown =
    .label = Markdown
pref-template-html =
    .label = HTML
pref-template-markdown-labels =
    .label = Markdown — Group > Label
pref-template-tex =
    .label = TeX (LaTeX)
pref-template-tex-labels =
    .label = TeX (LaTeX) — Group > Label
pref-entry-format-label = Entry format
pref-entry-format-description = How each annotation is written, in every template. Placeholders: {"{"}text{"}"}, {"{"}page{"}"}, {"{"}label{"}"}, {"{"}comment{"}"}, {"{"}type{"}"}, {"{"}color{"}"}, {"{"}author{"}"}, {"{"}date{"}"}, {"{"}tags{"}"}, {"{"}index{"}"}. {"{"}label, page{"}"} joins the non-empty values with the separator you write. Square brackets mark an optional part, dropped when its placeholders are empty. Examples: "{"{"}page{"}"} - {"{"}text{"}"}", "{"{"}text{"}"} ({"{"}page{"}"})", "{"{"}label, page{"}"} - {"{"}text{"}"}". Leave blank for the default, {"{"}text{"}"} ({"{"}label{"}"}[: {"{"}page{"}"}]). When the format includes {"{"}comment{"}"}, templates stop adding their own comment line.
pref-label-filter-mode-label = Colour labels
pref-label-filter-off =
    .label = Export all
pref-label-filter-include =
    .label = Only include
pref-label-filter-exclude =
    .label = Exclude
pref-label-filter-description = Comma-separated colour labels, e.g. "Definition, Yellow". Matches your Enhanced Notes custom label or the built-in colour name, ignoring case.
pref-tex-page-break =
    .label = TeX export: start each top-level group on a new page
pref-tex-preamble-label = TeX preamble (everything before \begin{"{"}document{"}"})
pref-tex-preamble-description = $title$ is replaced by the exported item's title (its Better BibTeX key when it has one). If there is no \documentclass line, \documentclass[12pt,letterpaper]{"{"}article{"}"} is added. Clear the box to use the default.
